<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- osmdroid merges optional location uses-features; this module has no
         location hardware requirement of its own -->
    <uses-feature android:name="android.hardware.location.network" tools:node="remove" />
    <uses-feature android:name="android.hardware.location.gps" tools:node="remove" />

    <application
        android:name=".App"
        android:label="NFC Hider"
        android:description="@string/app_description"
        android:allowBackup="false">

        <activity
            android:name=".SettingsActivity"
            android:label="NFC Hider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MapActivity"
            android:label="位置模拟"
            android:exported="false" />

        <activity
            android:name=".DexSqlActivity"
            android:label="DexSQL 查询"
            android:exported="false" />

        <!-- Receive the libxposed service binder from the framework -->
        <provider
            android:name="io.github.libxposed.service.XposedProvider"
            android:authorities="${applicationId}.XposedService"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />

        <!-- Fallback config channel: hooked apps read the simulation config here
             when the framework does not provide remote preferences -->
        <provider
            android:name=".location.ConfigProvider"
            android:authorities="${applicationId}.location"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />

        <!-- Expose as Xposed module -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="按应用 Hook：在 LSPosed 作用域中勾选需要生效的应用，重启该应用即可对其隐藏 NFC 并模拟定位。支持高德/Google/OSM地图切换、地点搜索、折叠控制面板与地点收藏。" />
        <meta-data
            android:name="xposedminversion"
            android:value="101" />

        <!-- Exclude auto-merged AndroidX components not needed for Xposed module -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            tools:node="remove" />
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:node="remove" />

    </application>

</manifest>
