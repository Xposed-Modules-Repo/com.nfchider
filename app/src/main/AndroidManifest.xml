<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".App"
        android:label="NFC Hider"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:description="@string/app_description"
        android:allowBackup="false">

        <!-- 主界面：NFC 隐藏开关与作用域指引 -->
        <activity
            android:name=".SettingsActivity"
            android:label="NFC Hider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Receive the libxposed service binder from the framework -->
        <provider
            android:name="io.github.libxposed.service.XposedProvider"
            android:authorities="${applicationId}.XposedService"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />

        <!-- Fallback config channel: hooked apps read the NFC-hiding config here
             when the framework does not provide remote preferences -->
        <provider
            android:name=".location.ConfigProvider"
            android:authorities="${applicationId}.location"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />

        <!-- Expose as Xposed module -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="按应用 Hook：在 LSPosed 作用域中勾选需要生效的应用，重启该应用即可对其隐藏 NFC 硬件。支持 Android 10+。" />
        <meta-data
            android:name="xposedminversion"
            android:value="101" />

        <!-- Exclude auto-merged AndroidX components not needed for Xposed module -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            tools:node="remove" />
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:node="remove" />

    </application>

</manifest>
